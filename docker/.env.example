# Копия шаблона: скопируйте в `docker/.env` и заполните реальными значениями.
# Файл docker/.env не попадает в git (см. .gitignore).

# PostgreSQL
POSTGRES_DB=MarketDataDb
POSTGRES_USER=marketdata_user
POSTGRES_PASSWORD=change-me-strong-password

# Kafka (адреса внутри compose-сети).
# Для single-node dev: kafka:9092. Для production 3-нодного кластера:
# kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# OpenTelemetry (адрес Aspire Dashboard / collector внутри compose-сети)
OTLP_ENDPOINT=http://aspire-dashboard:18889

# WebSocket-источник (по умолчанию реальная Binance)
EXCHANGE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws/{symbol}@trade

# Bearer/API-key для доступа к /metrics и /health в production.
# Задаётся как Auth__ApiKey в env воркера и используется healthcheck/blackbox/Prometheus.
# В development не нужен (middleware активен только если ключ задан).
AUTH_API_KEY=change-me-strong-api-key
